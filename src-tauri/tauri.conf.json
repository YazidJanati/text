{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "text",
  "version": "0.1.10",
  "identifier": "app.notes.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "text",
        "width": 1120,
        "height": 780,
        "minWidth": 560,
        "minHeight": 380,
        "backgroundColor": "#1e1e1e",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Minimal Markdown, Vim and math",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5ODRBMkMxQzJBNkU3RjQKUldUMDU2YkN3YUtFR1RBRTZ5emZBenliNEFrWjd4WHJXc0VicTlTWTE1ZlJzNHAxTGtXbWl2ZUwK",
      "endpoints": [
        "https://github.com/YazidJanati/text/releases/latest/download/latest.json"
      ]
    }
  }
}
